@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Мой Дом.ру</title>

    <link href="https://fonts.googleapis.com/css2?family=Inder&family=Jura:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />

    @* Устанавливаем тему ДО отрисовки — чтобы не мигало *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('dr_theme') || 'dark';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>
</head>
<body>

    <header class="header">
        <div class="header__inner">
            <a class="logo" asp-page="/Index" aria-label="Дом.ру">
    @*             <span class="logo__dot"></span>
                <span class="logo__text">Дом.ру</span> *@
            </a>

            <nav class="nav">
                <a class="nav__link" asp-page="/Index">Главная</a>
                <a class="nav__link" asp-page="/Wifi">WI-FI рядом</a>
                <a class="nav__link" asp-page="/Diagnost">Диагностика</a>
                <a class="nav__link" asp-page="/SpeedTest">Спидтест</a>
            </nav>

            <div class="header__actions">

                @* ---------- Переключатель темы ---------- *@
                <button id="themeToggle"
                        class="theme-toggle"
                        type="button"
                        aria-label="Переключить тему"
                        title="Переключить тему">
                    <span class="theme-toggle__sun">☀</span>
                    <span class="theme-toggle__moon">☾</span>
                </button>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="user">
                        <span class="user__avatar">@(User.Identity?.Name?.Substring(0, 1) ?? "U")</span>
                        <span class="user__name">@User.Identity?.Name</span>
                        <form method="post" asp-page="/Auth/Logout" class="user__form">
                            <button type="submit" class="user__exit">Выйти</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="user">
                        <a asp-page="/Auth/Login" class="user__login">Войти</a>
                        <a asp-page="/Auth/Register" class="user__register">Регистрация</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer__inner">
@*             <span class="footer__logo">Дом.ру</span>
 *@            <span class="footer__text">Цифровые сервисы и технологии для вашего дома</span>
            <a class="footer__link" asp-page="/Privacy">Подробнее о Дом.ру</a>
        </div>
    </footer>

    @* ---------- Cookie-баннер ---------- *@
    <div id="cookieBanner" class="cookie" hidden>
        <div class="cookie__inner">
            <span>
                Мы используем cookie и метрики для аналитики.
                Оставаясь на сайте, вы соглашаетесь с
                <a asp-page="/Privacy">политикой конфиденциальности</a>.
            </span>
            <button class="cookie__btn" type="button" onclick="acceptCookies()">Принять</button>
        </div>
    </div>

    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>